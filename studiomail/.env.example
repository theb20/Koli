# Configuration Firebase (StudioMail) — voir la console Firebase du projet
# studio-mail-22d14, Paramètres du projet > Vos applications > Config SDK.
# Ces valeurs ne sont pas secrètes (config client publique Firebase), mais
# restent hors dépôt comme le reste des .env du monorepo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
