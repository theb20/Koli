# Modèle de l'environnement de TEST LOCAL (copier en .env.test, jamais commité).
# Aucun secret de production : pas de SMTP/SMS/merchantgo/stockgo réels.
PORT=4100
NODE_ENV=development
DATABASE_URL=postgresql://<utilisateur>@localhost:5432/skignas_test
JWT_SECRET=<openssl rand -hex 32>
JWT_REFRESH_SECRET=<openssl rand -hex 32>
JWT_2FA_SECRET=<openssl rand -hex 32>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:5176
BACKEND_URL=http://localhost:4100
UPLOAD_DIR=./uploads-test
RESEND_API_KEY=re_test_dummy_never_sends

# Compte admin de test — laissez vide : seed-test génère un mot de passe aléatoire ici
TEST_ADMIN_EMAIL=admin.test@skignas.local
TEST_ADMIN_PASSWORD=
